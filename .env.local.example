# Supabase project settings (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings -> API -> service_role (Project API keys). Server-only, never
# exposed to the browser. Used to create accounts and sign people in
# directly (see signInWithNameAndPasscode) — never import it client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passcode people enter (along with their name) to sign in — never
# exposed to the browser (checked server-side only). Change this to
# whatever you want, and share it with whoever should have access.
TEAM_INVITE_PASSCODE=
